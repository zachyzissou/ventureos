# Plane.sh Environment Configuration

# Database Configuration
POSTGRES_USER=planeuser
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=planedb

# Redis Configuration
REDIS_HOST=plane-redis
REDIS_PORT=6379

# Security and Secret Keys
SECRET_KEY=your-very-long-and-secure-secret-key
DJANGO_SETTINGS_MODULE=plane.settings

# Email Configuration (Optional)
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
EMAIL_PORT=587
EMAIL_USE_TLS=true

# S3/Object Storage Configuration
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=plane-uploads

# Application Settings
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,plane.example.com

# Logging
LOG_LEVEL=INFO

# Additional Plane-specific settings
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# File Upload Settings
FILE_SIZE_LIMIT=5242880 # 5MB default