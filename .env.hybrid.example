# VentureOS Hybrid Deployment — Environment Configuration
# Copy to .env.hybrid and fill in real secrets (NEVER commit .env.hybrid)
#
# Generate secrets:
#   BRIDGE_TOKEN=$(openssl rand -base64 32)
#   DASHBOARD_API_TOKEN=$(openssl rand -base64 32)
#   POSTGRES_PASSWORD=$(openssl rand -base64 24)

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_DB=ventureos
POSTGRES_USER=ventureos
POSTGRES_PASSWORD=change-me
# Host-exposed port (avoids conflict with local Postgres)
POSTGRES_PORT=5433

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_PORT=8001
DASHBOARD_API_TOKEN=change-me

# ── Bridge (host service → container) ────────────────────────────────────────
# BRIDGE_TOKEN must match the token used by the host Bridge API
BRIDGE_URL=http://host.docker.internal:18790
BRIDGE_TOKEN=change-me

# ── Optional Overrides ───────────────────────────────────────────────────────
# DATABASE_URL=postgres://ventureos:change-me@db:5432/ventureos
# DASHBOARD_DATA_MODE=bridge
# DASHBOARD_BRIDGE_JSON_TIMEOUT_MS=10000
# DASHBOARD_BRIDGE_SSE_CONNECT_TIMEOUT_MS=10000
# DASHBOARD_ALLOW_LAN_BYPASS=false
# DASHBOARD_ENABLE_ACTIONS=false
