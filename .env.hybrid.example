# docker-compose.hybrid.yml environment
# Copy to .env.hybrid and fill in real secrets (do not commit .env.hybrid)

# Postgres
POSTGRES_DB=ventureos
POSTGRES_USER=ventureos
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Dashboard
DASHBOARD_PORT=8001
DASHBOARD_API_TOKEN=change-me

# Bridge (host service)
BRIDGE_URL=http://host.docker.internal:18790
BRIDGE_TOKEN=change-me

# Optional: override full DB URL (otherwise composed from POSTGRES_* vars)
# DATABASE_URL=postgres://ventureos:change-me@db:5432/ventureos
