# Huly connection
HULY_URL=http://localhost:8087
HULY_WORKSPACE=ws1

# Prefer token auth:
HULY_TOKEN=

# Or use email/password auth:
# HULY_EMAIL=user@example.com
# HULY_PASSWORD=...

# Tracker project identifier to target for VentureOS backlog
# (create the project in Huly UI first, then set it here)
HULY_PROJECT_IDENTIFIER=VENTUREOS

# Documents teamspace name to sync OpenClaw-Upgrade docs into
HULY_TEAMSPACE_NAME=VentureOS
