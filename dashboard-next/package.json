{
  "name": "ventureos-dashboard-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Next.js hybrid frontend for VentureOS dashboard (incremental migration track).",
  "scripts": {
    "dev": "npx next dev -p 7001",
    "build": "npx next build",
    "start": "npx next start -p 7001",
    "parity:readiness": "node scripts/parity-check-readiness.mjs",
    "parity:overview": "node scripts/parity-check-overview.mjs",
    "parity:logs": "node scripts/parity-check-logs.mjs",
    "parity:task-board": "node scripts/parity-check-task-board.mjs",
    "parity:all": "npm run parity:readiness && npm run parity:overview && npm run parity:logs && npm run parity:task-board",
    "smoke:task-board-write": "node scripts/smoke-check-task-board-write.mjs"
  },
  "dependencies": {
    "next": "^16.2.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
