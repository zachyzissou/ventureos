{
  "name": "ventureos",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "VentureOS core libraries (role cards, enforcement, handoff validation)",
  "workspaces": [
    "dashboard",
    "dashboard-next"
  ],
  "scripts": {
    "postinstall": "bash scripts/ensure-native-modules.sh",
    "test": "jest --runInBand && npm run test --workspace=dashboard",
    "test:dashboard": "npm run test --workspace=dashboard",
    "test:dashboard:coverage": "npm run test:coverage --workspace=dashboard",
    "build": "tsc -p tsconfig.json --noEmit && npm run build --workspace=dashboard",
    "build:tactical-map": "cd tactical-map && npm run build",
    "build:all": "npm run build && npm run build:tactical-map",
    "role-cards:render": "node -r ts-node/register ./scripts/generate-souls.ts",
    "role-cards:deploy": "node -r ts-node/register ./scripts/generate-souls.ts --deploy-workspaces",
    "test:e2e": "npx playwright test",
    "test:e2e:xss": "npx playwright test --grep XSS",
    "dashboard:dev": "npm run dev --workspace=dashboard",
    "dashboard:start": "npm run start --workspace=dashboard",
    "dashboard:build": "npm run build --workspace=dashboard",
    "dashboard:next:dev": "npm run dev --workspace=dashboard-next",
    "dashboard:next:build": "npm run build --workspace=dashboard-next",
    "dashboard:next:start": "npm run start --workspace=dashboard-next",
    "dashboard:next:parity": "npm run parity:all --workspace=dashboard-next",
    "dashboard:next:smoke": "npm run smoke:task-board-write --workspace=dashboard-next",
    "pr:queue:sweep": "bash scripts/pr-queue-sweep.sh",
    "pr:merge:readiness": "bash scripts/pr-merge-readiness.sh",
    "pr:required-checks:audit": "bash scripts/required-check-contexts.sh",
    "lint": "npm run docs:lint",
    "docs:lint": "python3 scripts/docs-lint.py",
    "roadmap:sync:check": "python3 scripts/roadmap-status-sync.py",
    "openclaw:local-smoke": "bash scripts/openclaw-local-smoke.sh",
    "openclaw:install": "bash scripts/ventureos-install.sh",
    "openclaw:install:preflight-evidence": "bash scripts/run-install-preflight-evidence.sh",
    "openclaw:post-merge:cadence": "bash scripts/post-merge-cadence.sh",
    "openclaw:post-merge:hook:install": "bash scripts/install-post-merge-hook.sh",
    "openclaw:post-merge:hook:health": "bash scripts/post-merge-hook-health.sh",
    "openclaw:post-merge:hook:status": "bash scripts/install-post-merge-hook.sh --status",
    "openclaw:post-merge:hook:uninstall": "bash scripts/install-post-merge-hook.sh --uninstall",
    "openclaw:post-merge:preflight-trigger": "bash scripts/post-merge-preflight-trigger.sh",
    "openclaw:post-merge:queue-snapshot": "bash scripts/post-merge-queue-snapshot.sh",
    "openclaw:local-ready": "bash scripts/refresh-local-integration-ready.sh",
    "openclaw:local-ready:cron": "bash scripts/openclaw-local-ready-cron.sh",
    "openclaw:local-ready:cadence": "bash scripts/openclaw-local-ready-cadence.sh",
    "openclaw:local-ready:status": "bash scripts/refresh-local-integration-ready.sh --skip-smoke --max-age-min 360",
    "openclaw:local-checklist:refresh": "bash scripts/refresh-local-integration-checklist.sh",
    "openclaw:local:integration-cadence:cron": "bash scripts/local-integration-cadence-cron.sh",
    "openclaw:local:integration-cadence": "bash scripts/run-local-integration-cadence.sh",
    "evidence:daily": "bash scripts/run-evidence-daily.sh",
    "evidence:weekly": "bash scripts/run-evidence-weekly.sh",
    "evidence:monthly": "bash scripts/run-evidence-monthly.sh",
    "evidence:validate": "bash scripts/validate-evidence.sh --cadence daily --target today",
    "readiness:phase0": "bash scripts/phase0-readiness.sh",
    "openclaw:bridge:launchagent": "bash scripts/install-bridge-launchagent.sh",
    "test:openclaw:local-smoke": "bash scripts/tests/test-openclaw-local-smoke.sh",
    "test:openclaw:local-ready": "bash scripts/tests/test-refresh-local-integration-ready.sh",
    "test:openclaw:local-ready-cron": "bash scripts/tests/test-openclaw-local-ready-cron.sh",
    "test:openclaw:local-ready-cadence": "bash scripts/tests/test-openclaw-local-ready-cadence.sh",
    "test:openclaw:local-checklist:refresh": "bash scripts/tests/test-refresh-local-integration-checklist.sh",
    "test:openclaw:local:integration-cadence:cron": "bash scripts/tests/test-local-integration-cadence-cron.sh",
    "test:openclaw:local:integration-cadence": "bash scripts/tests/test-run-local-integration-cadence.sh",
    "test:openclaw:post-merge:hook": "bash scripts/tests/test-install-post-merge-hook.sh",
    "test:openclaw:post-merge:hook:health": "bash scripts/tests/test-post-merge-hook-health.sh",
    "test:openclaw:post-merge:cadence": "bash scripts/tests/test-post-merge-cadence.sh",
    "test:openclaw:post-merge:preflight-trigger": "bash scripts/tests/test-post-merge-preflight-trigger.sh",
    "test:openclaw:post-merge:queue-snapshot": "bash scripts/tests/test-post-merge-queue-snapshot.sh",
    "test:openclaw:bridge-launchagent": "bash scripts/tests/test-install-bridge-launchagent.sh",
    "test:openclaw:install": "bash scripts/tests/test-ventureos-install.sh",
    "test:openclaw:install:preflight-evidence": "bash scripts/tests/test-run-install-preflight-evidence.sh",
    "test:pr:queue:sweep": "bash scripts/tests/test-pr-queue-sweep.sh",
    "test:pr:merge:readiness": "bash scripts/tests/test-pr-merge-readiness.sh",
    "test:pr:required-checks:audit": "bash scripts/tests/test-required-check-contexts.sh",
    "test:docs:lint": "python3 -m unittest scripts/tests/test_docs_lint.py",
    "test:roadmap:sync:check": "bash scripts/tests/test-roadmap-status-sync.sh",
    "test:perf": "cd tactical-map && PERF=1 npx playwright test tests/performance/",
    "test:perf:render": "cd tactical-map && PERF=1 npx playwright test tests/performance/render-performance.test.ts",
    "test:perf:load": "cd tactical-map && PERF=1 npx playwright test tests/performance/load-testing.test.ts",
    "test:perf:memory": "cd tactical-map && PERF=1 npx playwright test tests/performance/memory-leak.test.ts",
    "test:perf:network": "cd tactical-map && PERF=1 npx playwright test tests/performance/network-latency.test.ts",
    "test:a11y": "cd tactical-map && npx playwright test tests/accessibility/",
    "bench": "cd tactical-map && ./scripts/run-benchmarks.sh",
    "bench:token-compaction": "node -r ts-node/register ./scripts/benchmark-token-compactor.ts",
    "ci:code-factory:preflight": "node -r ts-node/register ./scripts/code-factory-preflight.ts",
    "ci:code-factory:verify-evidence": "node -r ts-node/register ./scripts/code-factory-verify-evidence.ts",
    "ci:code-factory:auto-remediate": "node -r ts-node/register ./scripts/code-factory-auto-remediate.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.30",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "minimatch": "10.2.1"
  }
}
