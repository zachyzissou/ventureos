{
  "name": "ventureos",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "description": "VentureOS core libraries (role cards, enforcement, handoff validation)",
  "workspaces": [
    "dashboard"
  ],
  "scripts": {
    "test": "jest --runInBand && npm run test --workspace=dashboard",
    "test:dashboard": "npm run test --workspace=dashboard",
    "test:dashboard:coverage": "npm run test:coverage --workspace=dashboard",
    "build": "tsc -p tsconfig.json --noEmit && npm run build --workspace=dashboard && cd tactical-map && npm run build",
    "role-cards:render": "node -r ts-node/register ./scripts/generate-souls.ts",
    "role-cards:deploy": "node -r ts-node/register ./scripts/generate-souls.ts --deploy-workspaces",
    "test:e2e": "npx playwright test",
    "test:e2e:xss": "npx playwright test --grep XSS",
    "dashboard:dev": "npm run dev --workspace=dashboard",
    "dashboard:start": "npm run start --workspace=dashboard",
    "dashboard:build": "npm run build --workspace=dashboard"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "better-sqlite3": "^12.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.30",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}