{
  "mcpServers": {
    "obsidian": {
      "command": "npx @mauricio.wolff/mcp-obsidian@latest /Users/zachgonser/Obsidian/VaultZap",
      "lifecycle": {
        "mode": "keep-alive",
        "idleTimeoutMs": 900000
      }
    },
    "unraid": {
      "baseUrl": "http://localhost:6970/mcp"
    },
    "gitlab": {
      "command": "npx",
      "args": [
        "-y",
        "@zereight/mcp-gitlab"
      ],
      "env": {
        "GITLAB_API_URL": "http://slurpnet:9080/api/v4",
        "GITLAB_READ_ONLY_MODE": "false",
        "USE_GITLAB_WIKI": "true",
        "USE_MILESTONE": "true",
        "USE_PIPELINE": "true"
      }
    }
  }
}