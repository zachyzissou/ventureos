# Host Bridge API environment (do not commit secrets)

BRIDGE_PORT=18790
BRIDGE_TOKEN=change-me
# Optionally read token from file (0600). If set, BRIDGE_TOKEN can be omitted.
# BRIDGE_TOKEN_FILE=/Users/you/.openclaw/bridge/bridge-token

# Allowlist for client CIDRs (Docker Desktop defaults shown)
BRIDGE_ALLOW_CIDRS=127.0.0.1/32,::1/128,192.168.65.0/24,172.17.0.0/16

# Rate limits (group=limit/window)
BRIDGE_RATE_LIMITS=default=60/60s;expensive=10/60s;sse=4/60s

# Logging
BRIDGE_AUDIT_LOG=/Users/you/clawd/logs/bridge-access.jsonl

# Host path overrides (optional)
OPENCLAW_DIR=/Users/you/.openclaw
VENTUREOS_ROOT=/Users/you/clawd/ventureos
SHARED_CONTEXT=/Users/you/clawd/shared-context
WORKSPACE_DIR=/Users/you/.openclaw/workspace-main
OPENCLAW_AGENT=main
