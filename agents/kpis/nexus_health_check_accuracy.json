{
  "kpi_id": "nexus_health_check_accuracy",
  "agent_id": "nexus",
  "category": "quality",
  "name": "Health Check Accuracy",
  "description": "Percentage of health checks that correctly identified agent status",
  "stakeholder_description": "How accurate is Nexus at detecting agent problems?",
  "formula": {
    "type": "ratio",
    "numerator": "accurate_health_checks",
    "denominator": "total_health_checks",
    "scale": 100
  },
  "data_sources": [
    {
      "table": "interaction_logs",
      "filter": "agent_id = 'nexus' AND action_type = 'health_check'",
      "field": "accuracy"
    },
    {
      "table": "psionic_stats",
      "filter": "agent_id = 'nexus'",
      "field": "approval_accuracy"
    }
  ],
  "thresholds": {
    "excellent": 0.98,
    "good": 0.95,
    "acceptable": 0.90,
    "poor": 0.80,
    "direction": "higher_is_better"
  },
  "visualization": {
    "dashboard_section": "nexus_tactical_overlay",
    "chart_type": "gauge",
    "update_frequency": "hourly",
    "color_scheme": "success_danger"
  },
  "audit_trail": {
    "created": "2026-02-14",
    "last_modified": "2026-02-14",
    "change_log": []
  }
}
