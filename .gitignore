# Ignore local MCP servers
/tools/openproject-mcp-server/
/tools/unraid-mcp/

# OS cruft
.DS_Store

# Local envs / deps
.venv/
**/.venv/
node_modules/

# Runtime/log artifacts
/runtime/
/archives/
*.log
*_report*.json
workflow_automation_logs/
metrics_logs/
heartbeat_response.txt
*_response.txt

# Backup/scratch files
*.bak
*.bak.*

# Project-level archives
projects/archives/

# Nested git repositories (subprojects)
projects/jav-library/
projects/slurpnet-security-suite/

# Local secrets / overrides
.credentials/
config/*.local.json
config/mcporter.json

# Repo hygiene scratch docs
REPO_HYGIENE_*.md
HYGIENE_*.md
COMMIT_CHECKLIST.md

# Backup variants
*.bak-*

# StantonTimes agent scratch/state (legacy project)
projects/stanton-times-agent/

# OpenClaw upgrade scratch project (superseded)
projects/openclaw-upgrade/

# Root python scratch (avoid confusing with project-specific requirements.txt)
/requirements.txt

# Python bytecode
__pycache__/
