{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["date", "captured_at", "handoffs", "summary"],
  "properties": {
    "date": { "type": "string" },
    "captured_at": { "type": "string" },
    "handoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["handoff_id", "producer", "consumer", "artifact", "sent_at"],
        "properties": {
          "handoff_id": { "type": "string" },
          "producer": { "type": "string" },
          "consumer": { "type": "string" },
          "artifact": { "type": "string" },
          "sent_at": { "type": "string" },
          "accepted_at": { "type": "string" },
          "producer_ts": { "type": "string" },
          "consumer_ts": { "type": "string" },
          "producer_binding_id": { "type": "string" },
          "consumer_binding_id": { "type": "string" },
          "producer_capability_id": { "type": "string" },
          "consumer_capability_id": { "type": "string" },
          "producer_specialist_id": { "type": "string" },
          "consumer_specialist_id": { "type": "string" },
          "sla_target_minutes": { "type": "number" },
          "latency_minutes": { "type": "number" },
          "sla_status": { "type": "string", "enum": ["on_time", "late", "exception"] },
          "compliance_status": { "type": "string", "enum": ["on_time", "late", "exception"] },
          "breach_level": { "type": "string", "enum": ["level_1", "level_2", "level_3"] },
          "breach_owner": { "type": "string" },
          "breach_action": { "type": "string" },
          "exception_approved_by": { "type": "string" },
          "exception_expires_at": { "type": "string" },
          "exceptions": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_handoffs": { "type": "number" },
        "on_time_handoffs": { "type": "number" },
        "late_handoffs": { "type": "number" },
        "exception_handoffs": { "type": "number" },
        "on_time_rate": { "type": "number" },
        "level_1_breaches": { "type": "number" },
        "level_2_breaches": { "type": "number" },
        "level_3_breaches": { "type": "number" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
