{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["date", "captured_at", "summary", "agents"],
  "properties": {
    "date": { "type": "string" },
    "captured_at": { "type": "string" },
    "source": { "type": "object" },
    "summary": { "type": "object" },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent_id", "status"],
        "properties": {
          "agent_id": { "type": "string" },
          "status": { "type": "string" },
          "session_count": { "type": "number" },
          "aborted_count": { "type": "number" },
          "success_rate": { "type": "number" },
          "last_updated_at": { "type": ["string", "null"] },
          "last_label": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "incidents": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "additionalProperties": true
}
